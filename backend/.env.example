# ============================================================
# APPOINTMENT REMINDER SYSTEM — BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Supabase ---
# Found at: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Twilio ---
# Found at: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
# For SMS: use your Twilio phone number in E.164 format e.g. +12345678900
# For WhatsApp sandbox: use whatsapp:+14155238886
TWILIO_FROM_NUMBER=+12345678900

# --- Frontend URL (for CORS) ---
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Reminder Scheduler ---
# How often (in minutes) the scheduler checks for upcoming appointments
# Default: 1 (every minute). Do not change unless needed.
SCHEDULER_INTERVAL_MINUTES=1
